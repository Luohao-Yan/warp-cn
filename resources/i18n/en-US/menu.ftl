## -- Menu a11y strings --

menu-instructions-with-submenu = Press the up key or the down key to select a menu item. Press the right key to open the submenu
menu-instructions = Press the up key or the down key to select a menu item
menu-submenu-expanded = Submenu Expanded
menu-open-submenu-help = Press the right key to open the selected submenu
menu-submenu-closed = Submenu Closed
menu-close-submenu-help = Removing focus from a submenu will close the submenu
menu-closed = Menu Closed
menu-close-help = Press the escape key to close the menu
menu-action-selected = Action Selected
menu-action-select-help = Press the enter key to execute the selected menu item action

