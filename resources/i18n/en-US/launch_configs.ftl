# =============================================================================
# launch_configs.ftl — Launch configuration modal strings
# =============================================================================
# Message IDs: launch-configs-{id}
# Used in app/src/launch_configs/*.rs
# =============================================================================

launch-configs-docs-link = Link to Documentation
launch-configs-saved-to = Saved successfully to { $path }
launch-configs-duplicate-name = Failed to save. A launch configuration with the same name already exists.
launch-configs-save-error = An issue was encountered while saving.
launch-configs-save-desc = This will save your current configuration of windows, tabs and panes to a file so you can easily open it again
launch-configs-modal-title = Save Config Modal
launch-configs-modal-a11y-desc = Type the name of the file to which you want to save your current configuration of windows, tabs, and panes. Use enter to save the launch configuration, esc to quit the save configuration modal.
launch-configs-yaml-path = The YAML file is saved to { $path }.
