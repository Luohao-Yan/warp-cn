## -- Find view strings --

view-components-find-result-of = Result { $current } of { $total }.
view-components-find-navigate-help = Use enter and shift-enter to navigate between matches. Escape to quit.
view-components-find-no-results = No results.
view-components-find-type-phrase = Type searched phrase.
view-components-find-escape-help = Press escape to quit, use enter and shift-enter to navigate between matches

view-components-find-next-occurrence = Find the next occurrence of your search query
view-components-find-prev-occurrence = Find the previous occurrence of your search query

view-components-rendered = Rendered
view-components-raw = Raw

