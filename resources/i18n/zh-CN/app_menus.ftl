# =============================================================================
# app_menus.ftl — 应用菜单栏字符串 (macOS / Linux / Windows)
# =============================================================================
# Message IDs: app_menus-{id}
# =============================================================================

## -- 常量（切换标签） ---------------------------------------------------------

app-menus-enable-shell-debug-mode = 为新会话启用 Shell 调试模式 (-x)
app-menus-disable-shell-debug-mode = 为新会话禁用 Shell 调试模式 (-x)
app-menus-enable-in-band-generators = 为新会话启用带内生成器
app-menus-disable-in-band-generators = 为新会话禁用带内生成器
app-menus-enable-pty-recording = 启用 PTY 录制模式 (warp.pty.recording)
app-menus-disable-pty-recording = 禁用 PTY 录制模式 (warp.pty.recording)
app-menus-show-bootstrap-block = 显示初始化块
app-menus-hide-bootstrap-block = 隐藏初始化块
app-menus-show-in-band-command-blocks = 显示带内命令块
app-menus-hide-in-band-command-blocks = 隐藏带内命令块
app-menus-show-ssh-command-blocks = 显示 Warp 化 SSH 块
app-menus-hide-ssh-command-blocks = 隐藏 Warp 化 SSH 块
app-menus-export-default-settings-csv = 将默认设置导出为 CSV 到主目录

